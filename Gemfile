source "https://rubygems.org"

# Matches the build GitHub Pages uses (bundles the right Jekyll version,
# jekyll-remote-theme, and supported plugins) so local preview renders
# identically to production.
gem "github-pages", group: :jekyll_plugins

# Boot-time speedups / platform shims that GitHub Pages also relies on.
gem "webrick", "~> 1.7"        # required to run `jekyll serve` on Ruby 3+
